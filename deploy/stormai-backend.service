# /etc/systemd/system/stormai-backend.service
[Unit]
Description=StormAI FastAPI backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/stormai/Backend
# The app reads Backend/.env from the working directory
ExecStart=/var/www/stormai/Backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
