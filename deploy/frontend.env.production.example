# Copy to /var/www/stormai/Frontend/.env.production BEFORE building.
# Vite bakes these into the JS at build time, so rebuild after any change.
# Only public values here (publishable keys), never secret keys.

VITE_API_URL=https://stormai.decodersdigital.net
VITE_API_PREFIX=api/v1
VITE_WS_URL=wss://stormai.decodersdigital.net
VITE_SKIP_AUTH=false
VITE_APP_NAME=Storm AI
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

VITE_STRIPE_PUBLISHABLE_KEY=CHANGE_ME
VITE_GOOGLE_CLIENT_ID=CHANGE_ME
VITE_GOOGLE_MAPS_API_KEY=CHANGE_ME

VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_SMS_AUTOMATION=true
VITE_ENABLE_INTEGRATIONS=true
VITE_SHOW_DEBUG_INFO=false
