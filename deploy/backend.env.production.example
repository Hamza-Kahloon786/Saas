# Copy to /var/www/stormai/Backend/.env on the server and fill in the values.
# NEVER commit the real file. Generate fresh secrets for production, do not reuse dev ones.

ENVIRONMENT=production
DEBUG=false

# openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=70

# MongoDB Atlas: add this VPS's public IP under Atlas > Network Access first
MONGODB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/crm_platform
DATABASE_NAME=crm_platform

FRONTEND_URL=https://stormai.decodersdigital.net
BACKEND_CORS_ORIGINS=https://stormai.decodersdigital.net
ALLOWED_HOSTS=stormai.decodersdigital.net,localhost,127.0.0.1
WEBHOOK_BASE_URL=https://stormai.decodersdigital.net

# Google sign-in. Add this exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://stormai.decodersdigital.net/api/v1/auth/google/callback

# Stripe (webhook endpoint: https://stormai.decodersdigital.net/api/v1/auth/stripe/webhook)
STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Twilio (SMS webhook: https://stormai.decodersdigital.net/api/v1/ai/webhooks/twilio)
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=CHANGE_ME

OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=150
ENABLE_OPENAI=1

# Email (Office365 SMTP)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_TLS=true
EMAILS_FROM_EMAIL=CHANGE_ME
EMAILS_FROM_NAME=Storm AI Services

# Optional integrations (leave blank if unused)
ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=false
SENDGRID_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
